# Supabase - obtener desde https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# URL publica del sitio - usada para construir la URL de respuesta de Payphone.
# En produccion debe ser el dominio real desplegado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payphone - pasarela de pagos (https://www.payphonetodoesposible.com)
# Token de la aplicacion web (se obtiene en el panel de Payphone).
PAYPHONE_TOKEN=
# Store ID de la aplicacion (panel de Payphone → Desarrollador → tu app). Obligatorio.
PAYPHONE_STORE_ID=

# Resend - correos transaccionales (https://resend.com)
# EMAIL_FROM requiere un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=RGL Estudio <noreply@tu-dominio.com>
