# Supabase - obtener desde https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# URL publica del sitio - usada para el callback de pago de Kushki.
# En produccion debe ser el dominio real desplegado.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kushki - pasarela de pagos (https://console.kushkipagos.com)
# NEXT_PUBLIC_KUSHKI_ENV: "sandbox" para pruebas, "production" en vivo
NEXT_PUBLIC_KUSHKI_ENV=sandbox
NEXT_PUBLIC_KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=

# Resend - correos transaccionales (https://resend.com)
# EMAIL_FROM requiere un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=RGL Estudio <noreply@tu-dominio.com>
